{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2019",
        "lib": ["es2022", "dom", "dom.iterable"],
        "jsx": "react",
        "outDir": "out",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "mocha"]
    },
    "include": ["main.tsx", "components", "midiDebugger", "test"],
    "exclude": ["out", "dist"]
}
